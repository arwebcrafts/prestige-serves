# ─── Stripe ──────────────────────────────────────────────────────────────────
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...

# Get Webhook secret from https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_...

# Optional: pre-create products in Stripe and paste their Price IDs here.
# If left blank, the server uses inline pricing (works out of the box).
STRIPE_PRICE_STANDARD_SERVICE=
STRIPE_PRICE_RUSH_SERVE=
STRIPE_PRICE_PRIORITY_SERVE=
STRIPE_PRICE_EMERGENCY_SERVE=
STRIPE_PRICE_SKIP_TRACE_STANDARD=
STRIPE_PRICE_SKIP_TRACE_RUSH=
STRIPE_PRICE_SKIP_TRACE_COURT=
STRIPE_PRICE_SKIP_TRACE_ENHANCED=
STRIPE_PRICE_SKIP_TRACE_BUSINESS=
STRIPE_PRICE_ADDON_DEFENDANT=

# ─── Email (Hostinger SMTP) ───────────────────────────────────────────────────
HOSTINGER_SMTP_HOST=smtp.hostinger.com
HOSTINGER_SMTP_PORT=465
HOSTINGER_SMTP_SECURE=true
HOSTINGER_SMTP_USER=info@prestigeserves.com
HOSTINGER_SMTP_PASS=your_email_password_here
FROM_EMAIL=info@prestigeserves.com
TO_EMAIL=prestigeservesllc@gmail.com

# ─── Site URL (used for Stripe redirect URLs) ────────────────────────────────
SITE_URL=https://www.prestigeserves.com

# ─── Google Reviews ──────────────────────────────────────────────────────────
# Enable Places API in Google Cloud and restrict this key to your domain/server.
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Optional but recommended. If empty, the server searches by GOOGLE_PLACE_QUERY.
GOOGLE_PLACE_ID=
GOOGLE_PLACE_QUERY=Prestige Serves Los Angeles CA

# ─── PST API (Process Server's Toolbox) ─────────────────────────────────────
# Must match client portal code=PRB at https://prb.sopstatus.com/forms/?code=PRB
PST_API_USERNAME=ApiUserPRB
PST_API_PASSWORD=your_pst_api_password_here
PST_DBS_CODE=PRB
PST_USE_TEST_API=false
